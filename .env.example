NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Public origin used to build short URLs (and to block shortening our own links)
BASE_URL=http://localhost:3000

# docker-compose publishes Mongo on 27018 and Redis on 6380, so they don't clash
# with a locally installed mongod/redis on the default ports.
MONGO_URI=mongodb://localhost:27018
MONGO_DB=url_shortener

# How many IDs each instance reserves from the counter per round-trip
ID_RANGE_SIZE=1000

# Set to true only when running behind a reverse proxy you control
TRUST_PROXY=false

REDIS_URL=redis://localhost:6380
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
NEGATIVE_CACHE_TTL_SECONDS=60

SHORTEN_RATE_LIMIT_WINDOW_SECONDS=60
SHORTEN_RATE_LIMIT_PER_IP=10
SHORTEN_RATE_LIMIT_GLOBAL=1000

CLICK_STREAM_MAX_LENGTH=1000000
WORKER_BATCH_SIZE=500
WORKER_BLOCK_MS=2000
WORKER_CLAIM_IDLE_MS=60000
# Download GeoLite2-Country.mmdb (free MaxMind account) and point to it; leave empty to skip geo lookup
GEOIP_DB_PATH=
IP_HASH_SECRET=dev-only-secret-change-me
