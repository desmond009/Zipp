NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Public origin used to build short URLs (and to block shortening our own links)
BASE_URL=http://localhost:3000

MONGO_URI=mongodb://localhost:27017
MONGO_DB=url_shortener

# How many IDs each instance reserves from the counter per round-trip
ID_RANGE_SIZE=1000
